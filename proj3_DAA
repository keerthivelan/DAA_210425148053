import tkinter as tk
from tkinter import ttk
import heapq

# =====================================================
# UNION FIND (FOR KRUSKAL)
# =====================================================
class UnionFind:
    def __init__(self, n):
        self.parent = list(range(n))
        self.rank = [0] * n

    def find(self, x):
        if self.parent[x] != x:
            self.parent[x] = self.find(self.parent[x])
        return self.parent[x]

    def union(self, x, y):
        rx = self.find(x)
        ry = self.find(y)

        if rx == ry:
            return False

        if self.rank[rx] < self.rank[ry]:
            rx, ry = ry, rx

        self.parent[ry] = rx

        if self.rank[rx] == self.rank[ry]:
            self.rank[rx] += 1

        return True


# =====================================================
# KRUSKAL ALGORITHM
# =====================================================
def kruskal(n, edges):

    edges.sort()

    uf = UnionFind(n)

    mst = []
    cost = 0

    for w, u, v in edges:

        if uf.union(u, v):

            mst.append((u, v, w))
            cost += w

            if len(mst) == n - 1:
                break

    return mst, cost


# =====================================================
# PRIM ALGORITHM
# =====================================================
def prim(n, graph):

    visited = [False] * n

    pq = [(0, 0, -1)]

    mst = []
    cost = 0

    while pq:

        weight, node, parent = heapq.heappop(pq)

        if visited[node]:
            continue

        visited[node] = True

        if parent != -1:
            mst.append((parent, node, weight))
            cost += weight

        for neighbour, wt in graph[node]:
            if not visited[neighbour]:
                heapq.heappush(pq, (wt, neighbour, node))

    return mst, cost


# =====================================================
# GRAPH
# =====================================================
n = 7

edges = [
    (7, 0, 1),
    (5, 0, 3),
    (8, 1, 2),
    (9, 1, 3),
    (7, 1, 4),
    (5, 2, 4),
    (15, 3, 4),
    (6, 3, 5),
    (8, 4, 5),
    (9, 4, 6),
    (11, 5, 6)
]

graph = {i: [] for i in range(n)}

for w, u, v in edges:
    graph[u].append((v, w))
    graph[v].append((u, w))


# =====================================================
# BUTTON FUNCTIONS
# =====================================================
def run_kruskal():

    table.delete(*table.get_children())
    output.delete("1.0", tk.END)

    mst, cost = kruskal(n, edges.copy())

    table.insert("", "end", values=("Kruskal", cost))

    output.insert(tk.END, "Selected MST Edges\n\n")

    for u, v, w in mst:
        output.insert(tk.END, f"{u} ---- {v}   Weight = {w}\n")


def run_prim():

    table.delete(*table.get_children())
    output.delete("1.0", tk.END)

    mst, cost = prim(n, graph)

    table.insert("", "end", values=("Prim", cost))

    output.insert(tk.END, "Selected MST Edges\n\n")

    for u, v, w in mst:
        output.insert(tk.END, f"{u} ---- {v}   Weight = {w}\n")


